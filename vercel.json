{
  "rewrites": [
    {
      "source": "/((?!assets/|video/|favicon\\.svg|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|og-image\\.png|resume\\.pdf|robots\\.txt|sitemap\\.xml|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ]
}
